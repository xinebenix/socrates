# Copy to .env.local for local development. On Railway, set these as service variables.

# ---------------------------------------------------------------- required

# Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# The gate on the whole app. Without it the deployment refuses to serve rather than
# coming up open — see lib/auth.ts. Generate one: openssl rand -base64 24
GYM_PASSWORD=

# ---------------------------------------------------------------- storage

# On Railway this MUST point inside the mounted volume, or the database is destroyed
# on every redeploy. With a volume mounted at /data, use /data/gym.db
GYM_DB=./data/gym.db

# ---------------------------------------------------------------- optional

# Model assignment preset. One variable sets all six call sites:
#   reference    everything Opus — the quality bar
#   shipped      D1-D3 items on Sonnet, every gate Opus  (default)
#   split-gate   Sonnet also validates D1-D3; deep items keep the Opus gate
#   sonnet-gate  Sonnet validates everything
#   economy      Haiku writes D1-D3, Sonnet writes D4-D6 and gates
#   floor        as economy, and Sonnet grades too (gives up invariant 9)
# Every preset keeps the blueprint on the strong model.
# Price them: npx tsx scripts/cost-model.ts
GYM_STRATEGY=shipped

# What a preset means by "the strong model".
GYM_MODEL=claude-opus-5

# Per call site, falling back to GYM_MODEL. Left unset, item writing splits by depth:
# D1-D3 (recall, comprehension, application) go to claude-sonnet-5, and D4-D6
# (boundary, discrimination, critique) escalate to GYM_MODEL — those are the depths
# whose distractors have to be nearly right. Setting GYM_MODEL_ITEM overrides the
# split at every depth.
GYM_MODEL_ITEM=
GYM_MODEL_BLUEPRINT=
GYM_MODEL_VALIDATE=
GYM_MODEL_GRADE=

# Validated, unserved items the worker keeps ready per plausibly-due cell — and,
# because a cell's whole shortfall goes into ONE generation call, also the size of a
# generation set. This is the rare dial that makes items CHEAPER per item as it goes
# up: the reasoning about the cell is divided across more of them. Capped at 10, past
# which the later items in a set get less attention and a truncated response loses
# the whole batch. What it costs is money committed earlier and a slower first fill.
GYM_BUFFER_TARGET=3

# Refill a cell once it has drained to this many remaining items — then refill it all
# the way back to the target in ONE call. Default is 40% of the target, so a cell of
# 10 regenerates after 6 have been used. Without this the buffer topped up by one
# after every served item, paying the cell's reasoning cost per item and undoing the
# saving that generating sets exists for. 0 = refill only when a cell runs dry.
GYM_BUFFER_REFILL_AT=

# Items generated at once. Capped at 12 — past that the account's rate limit is the
# bottleneck, and 429s are slower than waiting.
GYM_BUFFER_CONCURRENCY=4

# How often the in-process buffer worker runs. Minimum 5000.
GYM_WORKER_INTERVAL_MS=60000

# Reasoning effort per call site: low | medium | high | xhigh | max.
# Item generation is the hot path, so it is the dial worth turning. The other three
# are where a shortcut is expensive — a weaker validator is slower as well as worse,
# because it rejects sound items and each rejection costs two more calls.
GYM_EFFORT_ITEM=medium
GYM_EFFORT_BLUEPRINT=high
# Validation effort is depth-aware when unset: low for D1-D3, high for D4-D6.
# Setting this pins both ends.
GYM_EFFORT_VALIDATE=
GYM_EFFORT_GRADE=high

# The worker's speculative fills go through the Message Batches API at half price;
# results land a tick or two later, which a buffer can afford. Sessions never wait
# on a batch. Set to 0 to force everything synchronous, at double the price.
GYM_BATCH=1

# Set to 1 to run the server without the in-process buffer worker.
GYM_DISABLE_WORKER=

# Bearer token for GET /api/health, so diagnostics can be curled without a browser
# session. Generate one: openssl rand -hex 32
GYM_HEALTH_TOKEN=

# Set to 1 to knowingly run with no access control at all. Only meaningful when
# GYM_PASSWORD is empty. Do not set this on a public URL.
GYM_ALLOW_PUBLIC=

# ---------------------------------------------------------------------- cost
# Cells the worker pre-generates for. With GYM_BUFFER_TARGET this sets how many
# items get written ahead of you: 12 x 3 = 36 items, 72 model calls, per concept.
# A 20-question session uses 20 of them. Lower both if you train infrequently.
GYM_LOOKAHEAD_CELLS=12

# Pauses pre-generation once the month's ESTIMATED spend passes this. Sessions keep
# working — they just generate inline, paying only for questions actually served.
# Unset means no cap.
GYM_MONTHLY_BUDGET_USD=

# Override the built-in price table (USD per million tokens) when it goes stale.
# GYM_PRICES={"claude-opus-5":{"input":15,"output":75,"cachedInput":1.5}}
GYM_PRICES=
