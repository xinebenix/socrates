# Copy to .env.local for local development. On Railway, set these as service variables.

# ---------------------------------------------------------------- required

# Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# The gate on the whole app. Without it the deployment refuses to serve rather than
# coming up open — see lib/auth.ts. Generate one: openssl rand -base64 24
GYM_PASSWORD=

# ---------------------------------------------------------------- storage

# On Railway this MUST point inside the mounted volume, or the database is destroyed
# on every redeploy. With a volume mounted at /data, use /data/gym.db
GYM_DB=./data/gym.db

# ---------------------------------------------------------------- optional

GYM_MODEL=claude-opus-5

# Validated, unserved items the worker keeps ready per plausibly-due cell.
GYM_BUFFER_TARGET=3

# How often the in-process buffer worker runs. Minimum 5000.
GYM_WORKER_INTERVAL_MS=60000

# Set to 1 to run the server without the in-process buffer worker.
GYM_DISABLE_WORKER=

# Bearer token for GET /api/health, so diagnostics can be curled without a browser
# session. Generate one: openssl rand -hex 32
GYM_HEALTH_TOKEN=

# Set to 1 to knowingly run with no access control at all. Only meaningful when
# GYM_PASSWORD is empty. Do not set this on a public URL.
GYM_ALLOW_PUBLIC=
