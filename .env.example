# Copy to .env.local and fill in.

# Required. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
GYM_MODEL=claude-opus-5

# Optional. Defaults to ./data/gym.db
GYM_DB=./data/gym.db

# Optional. Validated, unserved items the worker keeps ready per plausibly-due cell.
GYM_BUFFER_TARGET=3
